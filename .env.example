# =============================================================================
# Capstone RAG — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# --- MongoDB Atlas (required) ---
# Connection string for your MongoDB Atlas cluster.
# Replace <user> and <password> with your database credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- OpenAI API Key (optional, for chat & embedding fallback) ---
# Only needed if you use OpenAI instead of the free Groq + HuggingFace stack.
# OPENAI_API_KEY=sk-your-openai-api-key

# --- OpenRouter API Key (optional) ---
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# --- LangSmith (optional, for observability) ---
# Sign up at https://smith.langchain.com to get an API key.
# LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=capstone-rag

# --- Application ---
APP_ENV=development